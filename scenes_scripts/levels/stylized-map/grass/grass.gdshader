shader_type spatial;
render_mode cull_disabled;

// Your existing uniforms
uniform float scale_x : hint_range(-1.0, 1.0) = 0.5;
uniform float skew_amount_x : hint_range(-2.0, 2.0) = 0.5;

// --- New Parabola Uniforms ---
// g = stretch/width modifier
uniform float stretch_g : hint_range(0.0, 1.0) = 1.0; // THE LOWER THIS IS THE LONGER THE PARABOLA IS
// o = slide offset
uniform float offset_o = 0.0;
// u = height/amplitude
uniform float height_u = 1.0;

// 0.0 = no pinch, 1.0 = perfect sharp point
uniform float top_pinch : hint_range(0.0, 1.0) = 1.0;

// For an RGBA color with transparency (Defaults to semi-transparent red)
uniform vec3 color : source_color = vec3(1.0, 0.0, 0.0);
uniform vec3 color_bottom : source_color;
uniform sampler2D noise;
uniform float noise_scale = 20.0;
varying vec3 world_pos; // used for the noise texture
// It controls how fast it transitions to the bottom color.
uniform float gradient_strength : hint_range(0.0, 2.0) = 1.0;

// Set this to the approximate max height of your grass mesh in Godot.
// If your mesh is 1 unit tall, leave it at 1.0.
uniform float mesh_height = 1.0;
// This passes the calculated height from the vertex to the fragment shader.
varying float local_height_mask;

void vertex() {
	// get the world position of the current vertex
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    // 1. Extract the random scale generated by Terrain3D's instancer
    vec3 scale = vec3(
        length(MODEL_MATRIX[0].xyz),
        length(MODEL_MATRIX[1].xyz),
        length(MODEL_MATRIX[2].xyz)
    );

    // 1. Calculate the inner value using UV.y
    float inner_val = (stretch_g * UV.y) + offset_o;

    // 2. Calculate the raw parabola: -(gx+o)^2 + u
    float raw_parabola = -(inner_val * inner_val) + height_u;

    // 3. The Fix: Clamp it!
    // If it drops below 0.0, this forces it to stay at 0.0 so it doesn't flare out.
    float parabola = max(0.0, raw_parabola);

    // 4. Determine the direction (Left or Right)
    float direction = sign(UV.x - 0.5);

    // 5. Apply the displacement
    VERTEX.x += parabola * direction;

    // --- Your existing skew/scale logic ---
    VERTEX.x -= VERTEX.x * scale_x;
    VERTEX.y += VERTEX.x * skew_amount_x;

    // 3. THE PINCH
    // We mix between 1.0 (normal width) and UV.y (shrinks to 0 at the top) based on your uniform.
    float pinch_factor = mix(1.0, UV.y, top_pinch);

    // Multiply the final X width by the pinch factor to crush the top together!
    VERTEX.x *= pinch_factor;

	// We do this AFTER the skew so it accurately reflects where the vertex ended up.
    // We divide by mesh_height to normalize it between 0.0 and 1.0.
    // We invert it (1.0 - ...) so the base is 1.0 and the top is 0.0, mimicking your UV.y.
    local_height_mask = 1.0 - clamp(VERTEX.y / mesh_height, 0.0, 1.0);
}

void fragment() {
	// 1. Calculate the spatial vertical gradient (replacing UV.y)
    float gradient_mix = clamp(local_height_mask * gradient_strength, 0.0, 1.0);
    vec3 spatial_base_color = mix(color, color_bottom, gradient_mix);

    // 2. Sample the noise texture
    vec3 noise_level = texture(noise, world_pos.xz / noise_scale).rgb;

    // 3. Combine the spatial gradient with the noise variation
    ALBEDO = spatial_base_color * mix(color, color_bottom, noise_level.r);

    // 4. Override the normals to always point straight up at the sky.
    NORMAL = (VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz;
}